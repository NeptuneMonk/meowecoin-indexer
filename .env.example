# Copy this file to .env and fill in the same rpcuser / rpcpassword you put in dogecoin.conf.
# .env is private. It is listed in .gitignore. Do not send it to anyone.

# Docker Desktop on Windows: the indexer container reaches the PC through this name.
# Plain Node on the same PC as Dogecoin: use http://127.0.0.1:22555 instead.
DOGE_RPC_URL=http://host.docker.internal:22555
DOGE_RPC_USER=meowe
DOGE_RPC_PASSWORD=change-this-password

# First block to read. 0 is the first Dogecoin block and the recommended value.
# The indexer then follows the chain all the way to the newest block.
# Set a higher number only when you mean to skip older history.
# Changing it later does nothing until you delete the database file.
START_HEIGHT=0

# The API listens here. Leave the host as 127.0.0.1 so only this computer can open it.
# Docker Compose publishes that port on 127.0.0.1 as well (see docker-compose.yml).
BIND_HOST=127.0.0.1
PORT=8080

# Which website may call the API from a browser.
# * is fine while the API stays on this computer.
# For the Forge site, you can set https://neptunemonk.github.io
CORS_ORIGIN=*

# Where the index is saved. One file. You can copy it to another computer.
DB_PATH=./data/meowecoin-indexer.sqlite

# Dogecoin mainnet P2FK version byte. Sup uses 30. Do not change this for mainnet.
VERSION_BYTE=30

# How often to look for new blocks after the indexer has caught up.
POLL_MS=15000
# How many blocks to save in one batch while catching up. The program does not
# stop after this many. It keeps going until it reaches the newest block.
BATCH_BLOCKS=200
